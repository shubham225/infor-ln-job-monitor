<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.shubham225</groupId>
	<artifactId>job-monitor</artifactId>
	<version>1.0.0</version>
    <packaging>pom</packaging>

    <name>job-monitor</name>
    <description>Parent module for the real-time Infor LN Job Monitoring Application.</description>

    <developers>
        <developer>
            <id>shubhamshinde225</id>
            <name>Shubham Shinde</name>
            <email>shubhamshinde225@gmail.com</email>
        </developer>
    </developers>

    <modules>
        <module>job-monitor-server</module>
        <module>job-monitor-common</module>
        <module>job-monitor-core</module>
    </modules>

	<properties>
		<java.version>17</java.version>
        <spring.boot.version>3.5.8</spring.boot.version>
        <picocli.version>4.7.7</picocli.version>
	</properties>

    <dependencyManagement>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-parent</artifactId>
            <version>${spring.boot.version}</version>
            <type>pom</type>
            <scope>import</scope>
		</dependency>
	</dependencies>
    </dependencyManagement>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
