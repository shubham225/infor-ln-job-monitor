<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.shubham225</groupId>
        <artifactId>job-monitor</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>job-monitor-web</artifactId>
    <packaging>jar</packaging>

    <name>JobMonitor - Web</name>
    <description>UI for Job Monitor, providing real-time job tracking and status APIs.</description>

    <developers>
        <developer>
            <id>shubhamshinde225</id>
            <name>Shubham Shinde</name>
            <email>shubhamshinde225@gmail.com</email>
        </developer>
    </developers>

    <properties>
        <node.version>v22.17.0</node.version>
        <yarn.version>v1.22.22</yarn.version>
        <frontend-maven-plugin.version>2.0.2</frontend-maven-plugin.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>${frontend-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>install-node-and-yarn</id>
                        <goals><goal>install-node-and-yarn</goal></goals>
                    </execution>
                    <execution>
                        <id>yarn-install</id>
                        <goals><goal>yarn</goal></goals>
                        <configuration><arguments>install</arguments></configuration>
                    </execution>
                    <execution>
                        <id>yarn-build</id>
                        <goals><goal>yarn</goal></goals>
                        <configuration><arguments>build</arguments></configuration>
                    </execution>
                </executions>
                <configuration>
                    <nodeVersion>${node.version}</nodeVersion>
                    <yarnVersion>${yarn.version}</yarnVersion>
                </configuration>
            </plugin>

            <!-- This makes sure the built static files end up bundled in the jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-frontend-build</id>
                        <phase>generate-resources</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF/resources</outputDirectory>
                            <resources>
                                <resource>
                                    <!-- next export/build output -->
                                    <directory>${basedir}/out</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
